{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Godot 4 Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "/snap/bin/godot4",
            "args": [
                "--headless",
                "--path", ".",
                "--main-scene", "Main.tscn"
            ],
            "cwd": "${workspaceFolder}",
            "externalConsole": true
        }
    ]
}
